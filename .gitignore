# ============================================================
# AvianDex — .gitignore（防增肥第一道門：進 Git 的東西會進 Vercel 建置）
# ============================================================

# 建置產物（絕不可提交；Vercel 每次部署會重新 build）
dist/
build/
out/

# 相依套件
node_modules/

# 大型模型檔（BirdNET ~56MB，只放 CDN/R2 或本地 public/models，絕不進 Git）
public/models/
*.bin
*.onnx

# 開發過程備份 / 暫存（任何 *.bak / *.orig / *.rej / *.tmp / *.old 一律不提交）
*.bak
*.tmp
*.old
*.orig
*.rej
*.swp
*~

# 日誌與快取
*.log
npm-debug.log*
.eslintcache
.vite/
.vite-source-tags.js
tsconfig.tsbuildinfo

# 環境變數（secret 只放本機 .env.local 與 Vercel Dashboard，絕不入 Git）
.env
.env.*
!.env.example

# Vercel
.vercel/

# 測試上傳 / 本機素材
uploads/
tmp/

# Python（圖卡引擎）
__pycache__/
*.pyc

# 系統檔
.DS_Store
Thumbs.db

# 圖卡體檢報告（由 scripts/probe-cards.mjs 產生，唔需要進 Git）
reports/

# 資料抓取快取（fetch-facts.mjs）
.cache/

# 資料工具產生的備份檔（不要在 repo 內留兩份 569 行 JSON）
src/data/birds.json.bak

# 圖卡插畫（大檔，只作本機素材；成品 AVIF 一律上傳 R2，不入 repo）
cards/art/

# 本機抽取的中間檔（由你電腦跑 extract-bilingual.mjs --out 產生；唔入 Git）
data/cardCopy.local.json
data/*.local.json

# 批量文案工作檔（本機用，不入 Git）
data/batches/
